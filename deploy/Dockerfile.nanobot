FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY integrations/nanobot/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --require-hashes -r requirements.txt && useradd --uid 10001 --create-home bankagent && mkdir /data && chown bankagent:bankagent /data
COPY integrations/nanobot/bank_agent.py integrations/nanobot/hosted_worker.py integrations/nanobot/service.py integrations/nanobot/channel_worker.py integrations/nanobot/channel_service.py ./
COPY integrations/nanobot/skills ./skills
USER bankagent
CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log", "--log-level", "critical"]
